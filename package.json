{
  "name": "m365-mcp-plugin",
  "displayName": "Outlook MCP (correo + agenda)",
  "description": "Da a tu agente de Copilot acceso a tu correo y agenda usando tu Outlook de escritorio (COM), sin login ni permisos de Entra. Incluye una bitacora de revision diaria de bandeja resumida por Copilot. Windows-only.",
  "version": "0.5.0",
  "publisher": "lrbg",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other",
    "AI"
  ],
  "keywords": [
    "outlook",
    "calendar",
    "com",
    "mcp",
    "copilot"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lrbg/MCP_Outlook.git"
  },
  "license": "MIT",
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:m365View"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "m365.mcpServers",
        "label": "Microsoft 365"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "m365",
          "title": "Microsoft 365",
          "icon": "media/m365.svg"
        }
      ]
    },
    "views": {
      "m365": [
        {
          "id": "m365View",
          "name": "Outlook MCP"
        }
      ]
    },
    "configuration": {
      "title": "Outlook MCP",
      "properties": {
        "m365.mcpScope": {
          "type": "string",
          "enum": [
            "ask",
            "user",
            "workspace"
          ],
          "enumDescriptions": [
            "Preguntar cada vez que haya una carpeta abierta",
            "Registrar el MCP para todo VS Code (recomendado)",
            "Registrar el MCP solo en la carpeta abierta (.vscode/mcp.json)"
          ],
          "default": "ask",
          "description": "Donde se registra el servidor MCP para Copilot Chat. Con 'user' funciona en cualquier ventana, aunque no haya carpeta abierta."
        },
        "m365.dailyReview.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Corre automaticamente una revision diaria de tu bandeja (no leidos) y la resume con Copilot en la Bitacora. Corre mientras VS Code este abierto."
        },
        "m365.dailyReview.hour": {
          "type": "number",
          "default": 8,
          "minimum": 0,
          "maximum": 23,
          "description": "Hora (0-23) a partir de la cual se corre la revision diaria. Si VS Code estaba cerrado a esa hora, se pone al dia al abrirlo."
        },
        "m365.dailyReview.maxEmails": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 100,
          "description": "Cuantos correos no leidos analizar en cada revision diaria."
        }
      }
    },
    "commands": [
      {
        "command": "m365.status",
        "title": "Outlook: Estado"
      },
      {
        "command": "m365.registerMcpServer",
        "title": "Outlook: Registrar servidor MCP (Copilot Chat)"
      },
      {
        "command": "m365.openDashboard",
        "title": "Outlook: Bitacora de bandeja (revision diaria)",
        "icon": "$(checklist)"
      },
      {
        "command": "m365.runDailyReview",
        "title": "Outlook: Correr revision de bandeja ahora"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "m365.openDashboard",
          "when": "view == m365View",
          "group": "navigation@0"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "test": "npm run compile && node --test test/"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.96.0",
    "typescript": "^5.5.0"
  }
}
