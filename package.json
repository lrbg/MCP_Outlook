{
  "name": "m365-mcp-plugin",
  "displayName": "Outlook MCP (correo + agenda)",
  "description": "Da a tu agente de Copilot acceso a tu correo y agenda usando tu Outlook de escritorio (COM), sin login ni permisos de Entra. Expone todo como servidor MCP. Windows-only.",
  "version": "0.4.0",
  "publisher": "lrbg",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other",
    "AI"
  ],
  "keywords": [
    "outlook",
    "calendar",
    "com",
    "mcp",
    "copilot"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lrbg/MCP_Outlook.git"
  },
  "license": "MIT",
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:m365View"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "m365.mcpServers",
        "label": "Microsoft 365"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "m365",
          "title": "Microsoft 365",
          "icon": "media/m365.svg"
        }
      ]
    },
    "views": {
      "m365": [
        {
          "id": "m365View",
          "name": "Outlook MCP"
        }
      ]
    },
    "configuration": {
      "title": "Outlook MCP",
      "properties": {
        "m365.mcpScope": {
          "type": "string",
          "enum": [
            "ask",
            "user",
            "workspace"
          ],
          "enumDescriptions": [
            "Preguntar cada vez que haya una carpeta abierta",
            "Registrar el MCP para todo VS Code (recomendado)",
            "Registrar el MCP solo en la carpeta abierta (.vscode/mcp.json)"
          ],
          "default": "ask",
          "description": "Donde se registra el servidor MCP para Copilot Chat. Con 'user' funciona en cualquier ventana, aunque no haya carpeta abierta."
        }
      }
    },
    "commands": [
      {
        "command": "m365.status",
        "title": "Outlook: Estado"
      },
      {
        "command": "m365.registerMcpServer",
        "title": "Outlook: Registrar servidor MCP (Copilot Chat)"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.96.0",
    "typescript": "^5.5.0"
  }
}
